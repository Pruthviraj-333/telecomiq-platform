# =========================
# PostgreSQL
# =========================
POSTGRES_DB=telecomiq
POSTGRES_USER=telecomiq_user
POSTGRES_PASSWORD=telecomiq_pass_2024

# =========================
# Spring Boot Backend
# =========================
DB_URL=jdbc:postgresql://postgres:5432/telecomiq
DB_USERNAME=telecomiq_user
DB_PASSWORD=telecomiq_pass_2024
JWT_SECRET=your-256-bit-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION=86400000
AI_SERVICE_URL=http://ai-service:8000

# =========================
# Gmail SMTP
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
MAIL_ENABLED=false

# =========================
# AI Service (FastAPI)
# =========================
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# =========================
# Frontend
# =========================
API_BASE_URL=http://localhost:8080/api
